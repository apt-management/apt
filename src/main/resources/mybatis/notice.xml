<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mapper.NoticeMapper">

    <select id="getNotices" resultType="com.example.model.Notice">
        SELECT * FROM notice ORDER BY id DESC LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="getTotalNotices" resultType="int">
        SELECT COUNT(*) FROM notice
    </select>

    <select id="findById" parameterType="java.lang.Integer" resultType="com.example.model.Notice">
        SELECT * FROM notice WHERE id = #{id}
    </select>

    <select id="getPrevNoticeId" resultType="java.lang.Integer">
        SELECT id FROM notice WHERE id &lt; #{id} ORDER BY id DESC LIMIT 1
    </select>

    <select id="getNextNoticeId" resultType="java.lang.Integer">
        SELECT id FROM notice WHERE id > #{id} ORDER BY id ASC LIMIT 1
    </select>

    <select id="getRecentNotices" resultType="com.login.login.Model.Notice">
        SELECT * FROM notice ORDER BY id DESC LIMIT 5
    </select>

    <delete id="deleteNotice" parameterType="int">
        DELETE FROM notice WHERE id = #{id}
    </delete>

</mapper>
